if-shell "uname | grep -q Darwin" "source-file $HOME/.tmux-macos.conf" \
                                  "source-file $HOME/.tmux-linux.conf"
set -g focus-events on
# Don't wait after a bare ESC to see if it starts an escape sequence
set -sg escape-time 0
setw -g mode-keys vi
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set-option -g -a update-environment " DBUS_SESSION_BUS_ADDRESS"
# unbind default prefix and set it to Ctrl+a
unbind C-b
set -g prefix C-a
bind C-a send-prefix
# Smart pane switching with awareness of Vim splits.
# See: https://github.com/christoomey/vim-tmux-navigator
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
bind-key -n C-h if-shell "$is_vim" "send-keys C-h"  "select-pane -L"
bind-key -n C-j if-shell "$is_vim" "send-keys C-j"  "select-pane -D"
bind-key -n C-k if-shell "$is_vim" "send-keys C-k"  "select-pane -U"
bind-key -n C-l if-shell "$is_vim" "send-keys C-l"  "select-pane -R"
bind-key -n 'C-\' if-shell "$is_vim" "send-keys C-\\" "select-pane -l"
bind-key -T copy-mode-vi C-h select-pane -L
bind-key -T copy-mode-vi C-j select-pane -D
bind-key -T copy-mode-vi C-k select-pane -U
bind-key -T copy-mode-vi C-l select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l

set -g status-style "bg=brightgreen,fg=black"
set -g message-style "bg=brightyellow,fg=black"
set -g message-command-style "bg=black,fg=brightyellow"
set -g mode-style "bg=brightyellow,fg=black"
set -g copy-mode-match-style "bg=brightcyan,fg=black"
set -g copy-mode-current-match-style "bg=brightmagenta,fg=black"
set -g copy-mode-mark-style "bg=brightred,fg=black"
set -g clock-mode-colour brightblue
set -g display-panes-colour brightblue
set -g display-panes-active-colour brightred
set -g pane-active-border-style "#{?pane_in_mode,fg=brightyellow,#{?synchronize-panes,fg=brightred,fg=brightgreen}}"
